{
   "type": "object",
   "properties": {
      "plants": {
         "description": "Configuration settings for the plants module",
         "type": "object",
         "properties": {
            "constants": {
               "description": "Constants for the plants module",
               "type": "object",
               "properties": {
                  "PlantsConsts": {
                     "type": "object"
                  }
               },
               "required": [
                  "PlantsConsts"
               ]
            },
            "pft_definitions_path": {
               "description": "A file path to a data file of plant functional type definitions",
               "type": "string"
            },
            "cohort_data_path": {
               "description": "A file path to a file of initial cohort data",
               "type": "string"
            },
            "static": {
               "type": "boolean",
               "default": false
            },
            "community_data_export": {
               "description": "Configuration of plant community data export",
               "type": "object",
               "properties": {
                  "required_data": {
                     "type": "array",
                     "items": {
                        "type": "string"
                     },
                     "uniqueItems": true,
                     "default": []
                  },
                  "cohort_attributes": {
                     "description": "A list of cohort attributes to write to file.",
                     "type": "array",
                     "items": {
                        "type": "string"
                     },
                     "uniqueItems": true,
                     "default": []
                  },
                  "community_canopy_attributes": {
                     "description": "A list of community canopy attributes to write to file.",
                     "type": "array",
                     "items": {
                        "type": "string"
                     },
                     "uniqueItems": true,
                     "default": []
                  },
                  "stem_canopy_attributes": {
                     "description": "A list of stem canopy attributes to write to file.",
                     "type": "array",
                     "items": {
                        "type": "string"
                     },
                     "uniqueItems": true,
                     "default": []
                  },
                  "float_format": {
                     "description": "A float format string to control data precision.",
                     "type": "string",
                     "default": "%0.5f"
                  }
               },
               "default": {},
               "required": [
                  "required_data",
                  "cohort_attributes",
                  "community_canopy_attributes",
                  "stem_canopy_attributes",
                  "float_format"
               ]
            }
         },
         "default": {},
         "required": [
            "pft_definitions_path",
            "cohort_data_path",
            "community_data_export",
            "static"
         ]
      }
   },
   "required": [
      "plants"
   ]
}